{
  "name": "trace-learning-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "start": "npm start --workspace backend",
    "test": "npm test --workspace backend",
    "test:e2e": "node tests/journey.mjs",
    "seed": "npm run seed --workspace backend",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"frontend/vite.config.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
